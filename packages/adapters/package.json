{
  "name": "@moldesk/adapters",
  "version": "0.1.0",
  "description": "Thin model-specific adapters for MoleculeDesk (translation/verification only)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriyapfn/moldesk.git",
    "directory": "packages/adapters"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/validate-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@moldesk/registry": "0.1.0",
    "@moldesk/runtime": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}

{
  "name": "@moldesk/core",
  "version": "0.1.0",
  "description": "Shared engine logic for MoleculeDesk (CLI + desktop)",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriyapfn/moldesk.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@moldesk/adapters": "0.1.0",
    "@moldesk/runtime": "0.1.0",
    "@moldesk/registry": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  }
}

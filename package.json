{
  "name": "moldesk-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "MoleculeDesk monorepo — CLI, core engine, runtime, and model registry",
  "license": "MIT",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "npm run dev -w @moldesk/cli",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "pack:verify": "node scripts/pack-verify.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/node": "^20.16.11",
    "vitest": "^3.0.0"
  }
}
